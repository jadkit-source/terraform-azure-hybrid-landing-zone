# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Allow only the CI-safe variable file
!environments/dev/dev.ci.tfvars
!environments/prod/prod.ci.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI plan files
*.tfplan

# Terraform CLI configuration
.terraformrc
terraform.rc

# Local environment / OS files
.env
.DS_Store
Thumbs.db