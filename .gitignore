# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI plan files
*.tfplan

# Terraform CLI configuration
.terraformrc
terraform.rc

# These environment files contain non-sensitive configuration only
!environments/dev/terraform.tfvars
!environments/prod/terraform.tfvars

# Local environment / OS files
.env
.DS_Store
Thumbs.db